<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<class name="datos.ItemPedido" table="itemPedido">

		<id name="idItemPedido" column="idItemPedido">
			<generator class="identity" />
		</id>

		<property name="cantidad" column="cantidad" type="integer" not-null="true" />

		<!-- * (ItemPedido) a 1 (Pedido). Lado dueño de la relacion,
 columna FK idPedido en la tabla itemPedido. -->
		<many-to-one name="pedido" class="datos.Pedido" column="idPedido" not-null="true" />

		<!-- * (ItemPedido) a 1 (Plato) -->
		<many-to-one name="plato" class="datos.Plato" column="idPlato" not-null="true" />

	</class>
</hibernate-mapping>