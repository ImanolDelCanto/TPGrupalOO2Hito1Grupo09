<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<class name="datos.Festival" table="festival">

		<id name="idFestival" column="idFestival">
			<generator class="identity" />
		</id>

		<property name="nombre"             column="nombre"             type="string" not-null="true" />
		<property name="temporada"          column="temporada"          type="string" not-null="true" />
		<property name="fechaInicio"        column="fechaInicio"        type="java.time.LocalDate" not-null="true" />
		<property name="fechaFin"           column="fechaFin"           type="java.time.LocalDate" not-null="true" />
		<property name="costoPorSuperficie" column="costoPorSuperficie" type="double" not-null="true" />
		<property name="costoPorMontaje"    column="costoPorMontaje"    type="double" not-null="true" />
		<property name="plusElectricidad"   column="plusElectricidad"   type="double" not-null="true" />
		<property name="costoSueldoBase"    column="sueldoBase"         type="double" not-null="true" />

		<!-- Relacion 1 (Festival) a * (UnidadDeVenta). Lado inverso: la FK
 vive en la tabla unidadDeVenta (propiedad "festival" de UnidadDeVenta). -->
		<set name="unidades" inverse="true" cascade="save-update" lazy="true">
			<key column="idFestival" not-null="true" />
			<one-to-many class="datos.UnidadDeVenta" />
		</set>

	</class>
</hibernate-mapping>