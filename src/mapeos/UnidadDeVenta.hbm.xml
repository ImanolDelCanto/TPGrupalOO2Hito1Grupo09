<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<!-- Clase padre abstracta. abstract="true" evita que Hibernate intente
		 instanciarla directamente (no tiene fila propia, solo sus subclases). -->
	<class name="datos.UnidadDeVenta" table="unidadDeVenta" abstract="true">

		<id name="idUnidad" column="idUnidad">
			<generator class="identity" />
		</id>

		<property name="nombreComercial" column="nombreComercial" type="string" not-null="true" />
		<property name="superficie"      column="superficie"      type="double" not-null="true" />
		<property name="codigoUnico"     column="codigoUnico"     type="string" not-null="true" unique="true" />

		<!-- * (UnidadDeVenta) --- 1 (Festival) -->
		<many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true" />

		<!-- * (UnidadDeVenta) --- 1 (Personal), el encargado de la unidad -->
		<many-to-one name="responsable" class="datos.Personal" column="idResponsable" not-null="false" />

		<!-- 1 (UnidadDeVenta) --- * (Personal). Lado inverso: la FK "idUnidad"
			 vive en la tabla personal (propiedad "unidad" de Personal). -->
		<set name="staff" inverse="true" cascade="save-update" lazy="true">
			<key column="idUnidad" />
			<one-to-many class="datos.Personal" />
		</set>

		<!-- 1 (UnidadDeVenta) --- * (Plato). Lado inverso: la FK "idUnidad"
			 vive en la tabla plato (propiedad "unidad" de Plato). -->
		<set name="platos" inverse="true" cascade="save-update" lazy="true">
			<key column="idUnidad" not-null="true" />
			<one-to-many class="datos.Plato" />
		</set>

		<!-- validarCodigo() es logica de negocio, no se mapea -->

		<!-- ============ HERENCIA ============ -->

		<joined-subclass name="datos.FoodTruck" table="foodTruck">
			<key column="idUnidad" />
			<property name="patente"              column="patente"              type="string"  not-null="true" unique="true" />
			<property name="requiereElectricidad" column="requiereElectricidad" type="boolean" not-null="true" />
		</joined-subclass>

		<joined-subclass name="datos.PuestoDesarmable" table="puestoDesarmable">
			<key column="idUnidad" />
			<property name="cantidadCarpas" column="cantidadCarpas" type="integer" not-null="true" />
			<property name="tiempoMontaje"  column="tiempoMontaje"  type="integer" not-null="true" />
		</joined-subclass>

	</class>
</hibernate-mapping>