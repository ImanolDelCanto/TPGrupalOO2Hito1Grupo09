<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>

	<class name="datos.Plato" table="plato">

		<id name="idPlato" column="idPlato">
			<generator class="identity" />
		</id>

		<property name="nombre"           column="nombre"           type="string" not-null="true" />
		<property name="precioVenta"      column="precioVenta"      type="double" not-null="true" />
		<property name="costoProduccion"  column="costoProduccion"  type="double" not-null="true" />

		<!-- * (Plato) a 1 (UnidadDeVenta). Lado dueño de la relacion,
 columna FK idUnidad en la tabla plato. -->
		<many-to-one name="unidad" class="datos.UnidadDeVenta" column="idUnidad" not-null="true" />

	</class>
</hibernate-mapping>